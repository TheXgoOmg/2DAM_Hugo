<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===============================================================
         ACCIÓN: Abre las vistas de equipo desde el menú
         =============================================================== -->
    <record id="paciente_action" model="ir.actions.act_window">
        <field name="name">Pacientes</field>
        <field name="res_model">hospital.pacientes</field>
        <field name="view_mode">list,form,search</field>
    </record>

    <!-- ===============================================================
         MENÚ PRINCIPAL Y SUBMENÚ DE EQUIPOS
         =============================================================== -->
    <menuitem name="Gestión Hospitalaria" id="hospital_menu_root"/>
    <menuitem name="Pacientes"
              id="pacientes_menu"
              parent="hospital_menu_root"
              action="paciente_action"/>

        <!-- ===============================================================
         LIST VIEW: Lista tabular de equipos
         =============================================================== -->
    <record id="hospital_pacientes_view_list" model="ir.ui.view">
        <field name="name">Lista de Pacientes</field>
        <field name="model">hospital.pacientes</field>
        <field name="arch" type="xml">
            <list string="Listado de Pacientes">
		<field name="nombre"/>
		<field name="dni"/>
		<field name="sip"/>
	    </list>
        </field>
    </record>

    <!-- ===============================================================
         SEARCH VIEW: Barra de búsqueda
         =============================================================== -->
    <record id="hospital_pacientes_view_search" model="ir.ui.view">
        <field name="name">Búsqueda de Pacientes por nombre</field>
        <field name="model">hospital.pacientes</field>
        <field name="arch" type="xml">
            <search>
		<field name="nombre"/>
		<field name="fecha_baja"/>
		<field name="motivo_baja"/>

		<separator/>
		
		<filter string="Pacientes Activos" name="active_patients" domain="[('fecha_baja', '=', False)]"/>
           	<filter string="Bajas por Defunción" name="death_cause" domain="[('motivo_baja', '=', 'defuncion')]"/>
            </search>
        </field>
    </record>

    <!-- ===============================================================
         FORM VIEW: Formulario de paciente
         =============================================================== -->
    <record id="view_hospital_pacientes_form" model="ir.ui.view">
    <field name="name">hospital.pacientes.form</field>
    <field name="model">hospital.pacientes</field>
    <field name="arch" type="xml">
        <form string="Ficha del Paciente">
            <header>
                </header>
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="historia_clinica"/>
                    </h1>
                </div>
                
                <group>
                    <group string="Información Personal">
                        <field name="nombre" placeholder="Seleccionar contacto..."/>
                        <field name="apellidos"/>
                        <field name="dni"/>
                        <field name="sip"/>
                    </group>
                    <group string="Datos de Control">
                        <field name="fecha_alta"/>
                        <field name="fecha_baja" 
                               readonly="fecha_baja != False" 
                               force_save="1"/>
                        <field name="motivo_baja" 
                               required="fecha_baja != False" 
                               invisible="not fecha_baja"/>
                    </group>
                </group>

                <notebook>
                    <page string="Detalles Demográficos" name="demographics">
                        <group>
                            <group>
                                <field name="fecha_nacimiento"/>
                                <field name="edad"/>
                                <field name="sexo"/>
                            </group>
                            <group>
                                <field name="raza"/>
                                <field name="estado_civil"/>
                                <field name="persona_contacto"/>
                            </group>
                        </group>
                    </page>

                    <page string="Historial Médico" name="medical_info">
                        <group string="Observaciones Clínicas">
                            <field name="enfermedades" widget="textarea" placeholder="Alergias, intolerancias..."/>
                            <field name="medicacion_cronica" widget="textarea"/>
                            <field name="antecedentes" widget="textarea"/>
                            <field name="intervenciones" widget="textarea"/>
                        </group>
                    </page>

                    <page string="Documentación" name="documents">
                        <group>
                            <field name="documento" filename="nombre_archivo_metadata"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
</odoo>
