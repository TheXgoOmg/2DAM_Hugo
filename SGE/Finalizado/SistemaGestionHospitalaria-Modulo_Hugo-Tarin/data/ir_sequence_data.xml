<odoo>
	<data>
		<record id="seq_hospital_paciente" model="ir.sequence">
			<field name="name">Secuencia de Pacientes</field>
			<field name="code">hospital.paciente.historia</field>
			<field name="prefix">NCH-</field>
			<field name="padding">6</field>
			<field name="company_id" eval="False"/>
		</record>
		<record id="seq_hospital_atencion_sanitaria" model="ir.sequence">
			<field name="name">Secuencia de Atención Sanitaria</field>
			<field name="code">hospital.atencion.icu</field>
			<field name="prefix">%(year)s/%(month)s/%(day)s/</field>
			<field name="padding">6</field>
			<field name="company_id" eval="False"/>
		</record>
	</data>
</odoo>
